  "static_findings": [
    {
      "id": "observer_separation",
      "classification": "validated",
      "note": "Observe and its reachable helpers do not create, query, close or terminate a Job handle and do not call a process-termination API. The owner process alone creates the Job and executes TerminateJobObject and Job CloseHandle. Closing inherited caller pipe handles cannot keep the observer capture pending because the owner is created with native bInheritHandles=false."
    },
    {
      "id": "creation_and_membership",
      "classification": "validated",
      "note": "The Job uses KILL_ON_JOB_CLOSE. The child coordinator is created suspended with the JOB_LIST creation attribute, then exact process identity and IsProcessInJob are recorded before ResumeThread. The Job handle is non-inheritable, and the coordinator CreateProcess also has bInheritHandles=false. The tested descendants remain in the owned Job; an unrelated sentinel is observed alive by every ordinary fixture."
    },
    {
      "id": "bounded_observation",
      "classification": "validated_with_limit",
      "note": "The observer persists deadline intent, writes a stop request, waits only its confirmation grace for owner completion, then reports pending if the owner/Job closure is not proved. The 3-second owner-side simulated termination delay produces a finite observer pending return. Late owner success does not rewrite the pending record."
    },
    {
      "id": "identity_and_hashes",
      "classification": "validated",
      "note": "Requests are hashed before use and rechecked before owner launch, by the owner and at observer close. A nonempty caller-supplied input hash map is checked at all phases. The frozen fixture map binds source, executable, fixture and CPU audit. Changed opening input prevents owner launch; changed closing input produces verification_failed and exit 4."
    },
    {
      "id": "slot_deadline",
      "classification": "validated_with_limit",
      "note": "SlotGuard checks exact coordinator PID plus creation time, schema/token, sequential observed indices, bounded QPC nanosecond intervals, and unchanged launch/deadline within an observed slot. Wrong identity and extension are rejected, and a stalled active slot triggers early tree cleanup. It checks terminal child identity fields when a terminal state is observed."
    },
    {
      "id": "owner_abrupt_exit",
      "classification": "validated",
      "note": "The independent fixture opens and holds the exact coordinator process handle before owner abort, verifies its creation time, waits for that handle to signal and records exit time greater than birth. This corroborates tested kill-on-close behavior. The observer record correctly stays pending because its own owner_terminal proof is absent."
    },
    {
      "id": "historical_source",
      "classification": "validated",
      "note": "v3, v4 and v5 source and fixture snapshots match their original certificate hashes. v3 reconstruction is disclosed; hashes identify the exact old bytes without altering original records."
    }
  ],
